{
  "buildCommand": "npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://treasure-hunt-backend.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://treasure-hunt-backend.onrender.com/uploads/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://treasure-hunt-backend.onrender.com/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
